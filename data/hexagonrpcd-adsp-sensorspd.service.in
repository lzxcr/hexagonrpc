[Unit]
Description=HexagonRPC — Qualcomm ADSP FastRPC daemon (sensors PD)
After=dev-fastrpc\x2dadsp.device dev-fastrpc\x2dadsp\x2dsecure.device
ConditionPathExists=|/dev/fastrpc-adsp
ConditionPathExists=|/dev/fastrpc-adsp-secure

[Service]
Type=exec
ExecStart=@bindir@/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
RestartForceExitStatus=SIGTERM
RestartPreventExitStatus=4
User=hexagonrpc
Group=hexagonrpc

[Install]
WantedBy=multi-user.target
