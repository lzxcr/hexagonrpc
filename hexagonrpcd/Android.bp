cc_binary {
    name: "hexagonrpcd",
    defaults: ["hexagonrpc_defaults"],
    srcs: [
        "aee_error.c",
        "apps_mem.c",
        "apps_std.c",
        "config.c",
        "hexagonfs.c",
        "hexagonfs_mapped.c",
        "hexagonfs_virt_dir.c",
        "method_defs.c",
        "iobuffer.c",
        "listener.c",
        "localctl.c",
        "rpcd.c",
        "rpcd_builder.c",
        "rpcmem_linux.c",
    ],
    shared_libs: [
        "libhexagonrpc",
        "libjson-c",
    ],
    vendor: true,
}
